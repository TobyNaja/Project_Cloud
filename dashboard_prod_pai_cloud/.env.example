# ตัวอย่างค่า environment variable ของ dashboard
# แอปไม่ได้โหลดไฟล์ .env เอง ให้ตั้งค่าใน shell ก่อนรัน หรือใส่ในหน้า Environment ของ Render
# ทุกตัวไม่บังคับ ถ้าไม่ตั้งเลย dashboard จะหาไฟล์ใน ../prodpai_cloud และ current_infra.json ของตัวเอง

# ไฟล์ JSON ที่ให้ dashboard อ่าน path แบบ relative อิงจากโฟลเดอร์ dashboard_prod_pai_cloud
# ใส่ได้หลายไฟล์โดยคั่นด้วย ; บน Windows หรือ : บน Linux และใส่เป็นโฟลเดอร์ก็ได้
INFRA_JSON_PATH=../prodpai_cloud/outputs.json

# โฟลเดอร์ Terraform ที่ใช้ตรวจหาไฟล์อัตโนมัติเมื่อไม่ได้ตั้ง INFRA_JSON_PATH (อ่านอย่างเดียว)
TERRAFORM_DIR=../prodpai_cloud

# ไฟล์ที่ POST /api/update และ export_infra.py เขียน ต้องอยู่นอกโฟลเดอร์ Terraform
INFRA_FILE=current_infra.json

# ชื่อ output ที่ใช้เมื่อไฟล์มาจาก `terraform output -json` แบบรวมทุก output
INFRA_OUTPUT_KEY=infrastructure_summary

# ไฟล์ที่ยัง parse ไม่ได้ภายในกี่วินาทีหลังถูกแก้ไข ให้ถือว่ากำลังเขียนอยู่ (ไม่ใช่ไฟล์เสีย)
INFRA_WRITE_GRACE_SECONDS=10

# 1 = แสดงข้อมูลตัวอย่างระหว่างรอไฟล์จริง, 0 = แสดงหน้าว่างพร้อมข้อความรอ
INFRA_SAMPLE_FALLBACK=1

PORT=5000
